<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Francirene" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:textColorPrimary">@color/colorText</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="materialButtonStyle">@style/Widget.Francirene.Button.Primary</item>
    </style>

    <style name="Theme.Francirene.NoActionBar" parent="Theme.Francirene">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ===== Typography, matching site's h1 weight 800 / muted body text ===== -->
    <style name="Text.Heading" parent="android:Widget.TextView">
        <item name="android:textColor">@color/heroHeading</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="Text.Subheading" parent="android:Widget.TextView">
        <item name="android:textColor">@color/colorText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="android:Widget.TextView">
        <item name="android:textColor">@color/heroMuted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.SectionLabel" parent="android:Widget.TextView">
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- ===== Buttons, matching .cta-primary / .cta-ghost ===== -->
    <style name="Widget.Francirene.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">6dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.Francirene.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/ctaGradientStart</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- ===== Inputs, matching site's 10px rounded fields ===== -->
    <style name="Widget.Francirene.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
    </style>

    <!-- ===== Cards, matching shadow-md / border-radius 12px ===== -->
    <style name="Widget.Francirene.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="contentPadding">14dp</item>
    </style>
</resources>
